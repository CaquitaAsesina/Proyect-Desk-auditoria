[TEMPLATE]
# Copia este archivo como .env y ajusta los valores

# Puerto y dirección donde escucha el servidor.
# HOST=0.0.0.0 permite que cualquier PC de la red acceda (recomendado).
PORT=3000
HOST=0.0.0.0

# ---- MySQL local ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=saltamonteXD2003*
DB_NAME=auditoria_db

# ---- MySQL en la nube (Aiven) ----
# Copia estos datos de la pestaña "Overview" de tu servicio MySQL en Aiven.
# Aiven exige conexión cifrada (TLS): deja DB_SSL=true, o descarga el
# certificado ca.pem desde el console y apunta DB_SSL_CA a su ubicación.
#DB_HOST=nombre-proyecto-servicio-xxxx.a.aivencloud.com
#DB_PORT=21067
#DB_USER=avnadmin
#DB_PASSWORD=tu_password_de_aiven
#DB_NAME=defaultdb
#DB_SSL=true
#DB_SSL_CA=/ruta/completa/a/ca.pem

# ---- Usuarios iniciales ----
# Se crean automáticamente la primera vez (cuando la tabla usuarios está vacía).
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=admin123
ADMIN_NOMBRE=Administrador
LECTURA_USUARIO=lectura
LECTURA_CONTRASENA=lectura123
LECTURA_NOMBRE=Usuario de consulta

# Secreto para firmar los tokens JWT (cámbialo por uno largo y aleatorio)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
